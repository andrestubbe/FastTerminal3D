<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.andrestubbe</groupId>
    <artifactId>FastTerminal3D</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>FastTerminal3D</name>
    <description>Terminal-mode 3D rendering bridge for FastSoftware3D — renders 3D scenes to console viewports using Unicode half-blocks and ANSI 24-bit True Color</description>
    <url>https://github.com/andrestubbe/FastTerminal3D</url>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>FastJava Team</name>
            <organization>FastJava</organization>
            <organizationUrl>https://github.com/andrestubbe</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/andrestubbe/FastTerminal3D.git</connection>
        <developerConnection>scm:git:ssh://github.com:andrestubbe/FastTerminal3D.git</developerConnection>
        <url>https://github.com/andrestubbe/FastTerminal3D/tree/main</url>
    </scm>

    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- FastSoftware3D - 3D rasterizer and pipeline -->
        <dependency>
            <groupId>com.github.andrestubbe</groupId>
            <artifactId>FastSoftware3D</artifactId>
            <version>0.1.0</version>
        </dependency>
        <!-- FastTerminal 0.1.3 - includes native renderAnsiNative -->
        <dependency>
            <groupId>com.github.andrestubbe</groupId>
            <artifactId>FastTerminal</artifactId>
            <version>0.1.3</version>
        </dependency>
        <!-- FastANSI - ANSI escape builder -->
        <dependency>
            <groupId>com.github.andrestubbe</groupId>
            <artifactId>FastANSI</artifactId>
            <version>0.1.1</version>
        </dependency>
        <!-- FastASCII - UTF-8 writer and glyph density -->
        <dependency>
            <groupId>com.github.andrestubbe</groupId>
            <artifactId>FastASCII</artifactId>
            <version>0.1.0</version>
        </dependency>
        <!-- FastKeyboard - Native keyboard inputs -->
        <dependency>
            <groupId>com.github.andrestubbe</groupId>
            <artifactId>FastKeyboard</artifactId>
            <version>0.1.0</version>
        </dependency>
        <!-- FastMouse - Native mouse inputs -->
        <dependency>
            <groupId>com.github.andrestubbe</groupId>
            <artifactId>FastMouse</artifactId>
            <version>0.1.0</version>
        </dependency>
        <!-- FastDWM - Native DWM timer period and window styling -->
        <dependency>
            <groupId>com.github.andrestubbe</groupId>
            <artifactId>FastDWM</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>fastterminal3d</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>

        <plugins>
            <!-- Maven Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>

            <!-- Maven Surefire Plugin for Tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
            </plugin>

            <!-- Maven JAR Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
            </plugin>

            <!-- Sources -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Dependency classpath helper for run scripts -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.0</version>
            </plugin>
        </plugins>
    </build>
</project>
